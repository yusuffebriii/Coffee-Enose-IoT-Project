# Salin file ini jadi "env.local.ps1" (tanpa .example) di folder yang sama,
# lalu isi dengan nilai asli. File "env.local.ps1" SENGAJA di-.gitignore
# supaya WiFi password & access token tidak ke-commit ke git.
#
# Catatan: sejak ada fitur wizard config (tekan 'c' saat boot di serial
# monitor), nilai di sini cuma jadi DEFAULT/FALLBACK kalau device belum
# pernah disimpan config lewat wizard. Ganti WiFi sehari-hari lebih gampang
# lewat wizard daripada edit file ini + build ulang.

$env:SSID = "nama_wifi_anda"
$env:PASSWORD = "password_wifi_anda"
$env:TB_HOST = "thingsboard.cloud"
$env:TB_TOKEN = "access_token_device_anda"
